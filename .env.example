# Host port exposed by docker compose.
HOST_PORT=8001

# Optional API key for callers. Leave empty or omit to disable auth.
# CONFIG_SERVER__API_KEY=your-api-key-here

# Gemini web cookie credentials. You can either set these here after copying
# this file to .env, or keep them in config/config.yaml.
# CONFIG_GEMINI__CLIENTS__0__ID=client-a
# CONFIG_GEMINI__CLIENTS__0__SECURE_1PSID=your-secure-1psid
# CONFIG_GEMINI__CLIENTS__0__SECURE_1PSIDTS=your-secure-1psidts

# Optional proxy for this Gemini client.
# CONFIG_GEMINI__CLIENTS__0__PROXY=socks5://host.docker.internal:1080
